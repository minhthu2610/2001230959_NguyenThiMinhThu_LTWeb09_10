<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <div class="container-fluid">
        <header>
            <h2>Fahasa.com</h2>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark ">
                <a href="@Url.Action("Index", "Home")">Trang chủ</a> |
                <a href="#">Đăng ký</a> |
                <a href="#">Đăng nhập</a> |
                <a href="#">Liên hệ</a>
            </nav>
            <hr />
        </header>

        <div class="row">
            <div class="col-md-2">
                <h4 class="bg-success"> CHỦ ĐỀ </h4> @Html.Action("DSMenu_ChuDe", "Home")
                <h4 class="bg-success"> NHÀ XUẤT BẢN </h4> @Html.Action("DSMenu_NXB", "Home")
            </div>
            <div class="col-md-9 bg-light">
                <div>
                    <img src="~/Content/images/anhbia.jpg"
                         class="img-responsive"
                         style="width: 100%; height:500px" />
                </div>
                <hr />
                <div>
                    @RenderBody()
                </div>
            </div>
        </div>

        <footer class="mt-3 border-top pt-2 text-center">
            <small>Liên hệ: Khoa CNTT - Trường Đại học Công nghiệp TP.HCM</small>
        </footer>
    </div>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
