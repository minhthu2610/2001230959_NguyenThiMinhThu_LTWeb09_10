<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    @Styles.Render("~/Content/Site.css")
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body>
    <div class="container-fluid">
        <header class="header">
            <div class="logo">
                <h2>Fahasa.com</h2>
            </div>

            <nav class="navbar">
                <a href="@Url.Action("Index", "Home")">Trang chủ</a>
                    @if (Session["TaiKhoan"] == null)
                    {
                        <a href="@Url.Action("DangKy", "Home")">Đăng ký</a>
                        <a href="@Url.Action("DangNhap", "Home")">Đăng nhập</a>
                    }
                    else
                    {
                        var kh = (LTWeb09_BTM1.Models.KHACHHANG)Session["TaiKhoan"];
                        <span class="text-light ms-2">Xin chào, <strong>@kh.HOTEN</strong></span>
                        <a href="@Url.Action("DangXuat", "Home")" class="ms-3">Đăng xuất</a>
                    }
                <a href="#">Liên hệ</a>
                <a href="@Url.Action("TimKiemNangCao", "Home")" class="text-light ms-3">Tìm kiếm nâng cao</a>
            </nav>

            <div>
                <form action="@Url.Action("TimKiem", "Home")" method="get" class="search-box">
                    <input type="text" name="tuKhoa" placeholder="Tìm kiếm..." />
                    <button class="btn btn-light text-danger fw-bold" type="submit">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
            </div>
        </header>
        <main class="container-fluid mt-4">
            <div class="row">
                <aside class="col-md-3">
                    <h4> CHỦ ĐỀ </h4> @Html.Action("DSMenu_ChuDe", "Home")
                    <h4> NHÀ XUẤT BẢN </h4> @Html.Action("DSMenu_NXB", "Home")
                </aside>
                <section class="col-md-9 bg-light">
                    <div>
                        <img src="~/Content/images/anhbia.jpg"
                             class="img-responsive"
                             style="width: 100%; height:500px" />
                    </div>
                    <hr />
                    <div>
                        @RenderBody()
                    </div>
                </section>
            </div>
        </main>
        <footer>
            <small>Liên hệ: Khoa Công Nghệ Thông Tin - Trường Đại học Công nghiệp TP.HCM</small><br>
            <small>Địa chỉ: 140 Lê Trọng Tấn, phường Tây Thạnh, TP. HCM   ĐT: (028)38161673  Mail: fit@huit.edu.vn</small>
        </footer>
    </div>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
