@{
    ViewBag.Title = "Đăng nhập";
}

<h2 class="text-center text-primary mt-3">ĐĂNG NHẬP TÀI KHOẢN</h2>
<hr />

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        @using (Html.BeginForm("DangNhap", "Home", FormMethod.Post))
        {
            <div class="mb-3">
                <label for="taiKhoan" class="form-label fw-bold">Tên đăng nhập</label>
                <input type="text" name="taiKhoan" id="taiKhoan" class="form-control" placeholder="Nhập tên đăng nhập..." required />
            </div>

            <div class="mb-3">
                <label for="matKhau" class="form-label fw-bold">Mật khẩu</label>
                <input type="password" name="matKhau" id="matKhau" class="form-control" placeholder="Nhập mật khẩu..." required />
            </div>

            <button type="submit" class="btn btn-outline-primary w-100 fw-bold">Đăng nhập</button>

            <div class="mt-3 text-center">
                <small>
                    Bạn chưa có tài khoản?
                    <a href="@Url.Action("DangKy", "Home")" class="text-decoration-none fw-semibold">Đăng ký ngay</a>
                </small>
            </div>
        }

        @if (ViewBag.ThongBao != null)
        {
            <div class="alert alert-danger text-center mt-3">
                @ViewBag.ThongBao
            </div>
        }
    </div>
</div>
